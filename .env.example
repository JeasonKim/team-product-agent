# 仅填写到本机 .env。默认使用 API Key；Codex 可在项目配置中明确选择 local_login。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 可复用 lark-cli 1.0.80+ 的独立应用配置；设置后优先使用 CLI，不需要复制 App Secret。
FEISHU_CLI_PROFILE=
# 存在多份 CLI 时指定完整路径，避免 pnpm 与交互终端选中不同版本。
FEISHU_CLI_PATH=

# 飞书自建应用；开启机器人能力，订阅 im.message.receive_v1，选择长连接。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊用于准确判断是否 @ 当前机器人；未配置时不接收群聊需求。
FEISHU_BOT_OPEN_ID=
